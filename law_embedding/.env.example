# ══════════════════════════════════════════════════════════════════════
#  law_embedding / law_indexer (임베딩기 · 소비자) 환경변수
#  cp .env.example .env  후 값을 채운다. (.env 는 커밋 금지)
#
#  읽는 법: 블록 머리의 대괄호가 "언제 이 블록이 필요한가" 다.
#    [공통]        = 어떤 모드든 항상
#    [X=Y 일 때만] = 그 스위치를 그 값으로 뒀을 때만 채운다. 아니면 통째로 무시
#
#  빈 값 주의 1: 문자열 키는 `KEY=` 로 비워두면 "미설정" 으로 동작하지만(폴백이 걸린다),
#    숫자 키는 빈 값이면 int()/float() 에서 터진다 — 지우지 말고 값을 둘 것.
#  빈 값 주의 2: 빈 값 뒤에는 같은 줄 주석을 달지 마라. `KEY=   # 설명` 은 dotenv 가
#    주석 문자열을 값으로 읽는다(실측). 그래서 빈 키는 설명을 윗줄에 둔다.
# ══════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────
# [Weaviate 접속 · 항상 필요]
#   로컬 개발은 익명 접속(키 비움), genos 등 인증 VDB 는 API 키를 채운다.
# ──────────────────────────────────────────────────────────────────────
WEAVIATE_HTTP_HOST=localhost             # REST 호스트
WEAVIATE_HTTP_PORT=8081                  # REST 포트. 코드 기본은 8080 이나 로컬 compose 는 8081(8080 은 temporal-ui)
WEAVIATE_GRPC_HOST=localhost             # gRPC 호스트
WEAVIATE_GRPC_PORT=50051                 # gRPC 포트
WEAVIATE_SECURE=false                    # true 면 http/gRPC 둘 다 TLS 로 접속
# 정의서 값은 복제 3 · 샤드 3(운영 3노드). **노드 수를 넘길 수 없다** — 1노드 개발기는 1/1 로 낮춘다
#   (3 을 요구하면 컬렉션 생성 자체가 거부된다). acorn·async 복제는 노드 수와 무관해 항상 적용된다.
WEAVIATE_REPLICATION_FACTOR=3
WEAVIATE_SHARD_COUNT=3

# -- 인증 Weaviate 일 때만: API 키. 비우면 익명 접속 --
# genos 는 VDB 를 컬렉션 단위로 발급해 키가 서로 다르고, 각 키는 자기 컬렉션만 본다(RBAC).
# 아래 둘을 비우면 WEAVIATE_API_KEY 를 그대로 쓴다(같은 VDB 를 볼 때).
WEAVIATE_API_KEY=
ADMRUL_WEAVIATE_API_KEY=
SCHLPUB_WEAVIATE_API_KEY=

# -- 로컬 docker compose 로 Weaviate 를 띄울 때만 --
WEAVIATE_IMAGE=cr.weaviate.io/semitechnologies/weaviate:1.29.0   # docker-compose.yml 이 쓰는 이미지 태그


# ──────────────────────────────────────────────────────────────────────
# [컬렉션] 데이터 레포 3개(LAW/ADMRUL/SCHLPUBRUL)에 컬렉션 하나씩
#   속성 스키마는 셋 다 같고 클래스 이름만 다르다.
# ──────────────────────────────────────────────────────────────────────
LAW_COLLECTION=LegalProvisionIndex       # 법령 컬렉션. (옛 WEAVIATE_COLLECTION 값을 기본값으로 물려받음)
ADMRUL_COLLECTION=AdmrulProvisionIndex   # 고시·훈령·예규 컬렉션
SCHLPUB_COLLECTION=SchlPubRulProvisionIndex   # 학칙·공단정관·공공기관 컬렉션
# 하이브리드 검색의 BM25 절반을 담당하는 search_text 토크나이저.
#   kagome_kr 은 Weaviate 에 ENABLE_TOKENIZER_KAGOME_KR=true 가 있어야 하고,
#   없으면 컬렉션 생성이 trigram 으로 자동 폴백된다(검색 품질 하락, 경고 로그).
SEARCH_TEXT_TOKENIZATION=kagome_kr       # kagome_kr(한국어 형태소, 기본) | trigram 등


# ──────────────────────────────────────────────────────────────────────
# [임베딩] EMBEDDING_BACKEND 로 로컬 로드와 원격 호출을 고른다
#   local  = 모델을 프로세스에 직접 로드(기본, 모델 다운로드·RAM 필요)
#   remote = OpenAI 호환 /v1/embeddings 를 호출(genos 모델 서빙 등)
#   색인과 질의가 같은 백엔드·같은 모델을 써야 벡터가 맞는다.
# ──────────────────────────────────────────────────────────────────────
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3              # 1024차원. 바꾸면 컬렉션을 새로 만들어야 한다(차원이 잠긴다)
#   ★ 모델 교체 절차: create-collection --recreate 로 컬렉션을 비우고 전량 재색인.
#     Weaviate 는 첫 적재 차원으로 컬렉션을 잠그므로, 그냥 바꾸면 upsert 가 차원 불일치로 거부된다.
#     law_agent(질의측)도 같은 모델·같은 백엔드로 함께 바꿔야 벡터가 같은 공간에 놓인다.
EMBEDDING_BATCH_SIZE=16                  # 한 번에 임베딩할 청크 수
NORMALIZE_EMBEDDINGS=true                # 벡터를 L2 정규화할지
CHUNK_MAX_CHARS=2500                     # 조문/별표 청크 최대 글자 수(모델 학습 길이 기준)
INDEX_EMBED_FLUSH=256                    # 이만큼 모이면 임베딩·적재를 한 번 내보낸다

# -- EMBEDDING_BACKEND=remote 일 때만 --
# /v1/embeddings 서빙 base URL, 그리고 그 인증 키(비우면 무인증 — 같은 메시 안에서 부를 때)
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=180                    # 호출 타임아웃 초. 게이트웨이 부하 시 60초로는 부족했다
EMBEDDING_MAX_RETRIES=3                  # 호출 실패 재시도 횟수


# ──────────────────────────────────────────────────────────────────────
# [데이터 레포] 초기 full 색인(`index`)과 `sync` 가 읽는 수집 산출물
#   레포 3개를 각각 clone/fetch 한다. package 소비만 하는 배포라면 손댈 일이 적다.
# ──────────────────────────────────────────────────────────────────────
INPUT_DATA_PATH=../data                  # 레포들을 담는 루트. `index` 가 --input 없이 재귀 순회하는 곳
# 아래 세 PATH 는 비우지 말 것 — LAW/ADMRUL 은 빈 값이면 INPUT_DATA_PATH 폴백이 아니라
# 현재 디렉터리(.)가 된다. 기본값을 쓰려면 줄 전체를 주석 처리한다.
LAW_REPO_URL=https://github.com/genonai/LAW.git
LAW_REPO_PATH=../data/LAW                # 줄을 지우면 INPUT_DATA_PATH/LAW
LAW_REPO_BRANCH=main
ADMRUL_REPO_URL=https://github.com/genonai/ADMRUL.git
ADMRUL_REPO_PATH=../data/ADMRUL          # 줄을 지우면 INPUT_DATA_PATH/ADMRUL
ADMRUL_REPO_BRANCH=main
SCHLPUB_REPO_URL=https://github.com/genonai/SCHLPUBRUL.git
SCHLPUB_REPO_PATH=../data/SCHLPUBRUL     # 여기만 빈 값이 유효하다: 비우면 ADMRUL 레포로 폴백(옛 2레포 구성)
SCHLPUB_REPO_BRANCH=main
GIT_SYNC_TIMEOUT=3600                    # clone/fetch 타임아웃 초. 최초 clone 은 수 GB라 짧으면 타임아웃난다
# git 에는 항상 원본(한글) 이름이 들어 있다. 경로요소가 255바이트를 넘는 소수 파일은 리눅스가
# checkout 을 못 해, sync 가 그 파일만 safe 이름으로 로컬에 materialize 한다(설정 없음).


# ──────────────────────────────────────────────────────────────────────
# [전처리기(Doc Parser)] 첨부(is_file_only 별표·행정규칙 attachments·package file 레코드) 처리
#   DOC_PARSER_BASE_URL 이 비면 = 전처리기 없음 → 그 첨부들은 보류(pending) 처리된다.
#   이 값의 유무가 package 소비 때 "file 레코드를 전처리할지" 도 자동으로 정한다.
# ──────────────────────────────────────────────────────────────────────
# 전처리기 base URL. 비면 전처리 안 함
DOC_PARSER_BASE_URL=
INDEX_PREPROCESS_FILES=true              # `index` 명령이 첨부를 전처리할지. false 면 본문 JSON 만 색인하고 첨부는 건너뛴 수로 집계

# -- DOC_PARSER_BASE_URL 을 채웠을 때만: 호출 방식 --
DOC_PARSER_ENDPOINT_PATH=/run            # 첨부용(hwp/pdf/docx 등) 경로. genos 는 /preprocess_attachment_upload
DOC_PARSER_UPLOAD=false                  # true=파일을 multipart 업로드 / false=파일 경로를 JSON 으로 전달
DOC_PARSER_TIMEOUT=60                    # 호출 타임아웃 초
# 이미지 전용 경로. 비우면 위 경로 하나만 쓴다. genos 는 /preprocess_intelligent_upload
DOC_PARSER_IMAGE_ENDPOINT_PATH=
# Bearer 토큰. 비면 무인증. 실제 키는 .env 에만 두고 커밋 금지
DOC_PARSER_API_KEY=
DOC_PARSER_MAX_RETRIES=2                 # 재시도 횟수(결정적 오류는 재시도하지 않음)
DOC_PARSER_IMAGE_CONCURRENCY=1           # 문서 하나 안에서 이미지 OCR 을 몇 개까지 동시에 부를지
DOC_PARSER_KEEP_TEMP_FILES=false         # true 면 전처리에 쓴 임시 파일을 지우지 않는다(디버그)

# -- 엔드포인트가 옛 /run 목업일 때만: 청킹 파라미터 --
# genos 전처리기는 내부에서 청킹해 이 값을 안 쓴다(코드가 /run 일 때만 params 로 넘긴다).
DOC_PARSER_CHUNK_SIZE=2000               # 목업이 자를 청크 글자 수
DOC_PARSER_CHUNK_OVERLAP=200             # 그 청크 간 겹침 글자 수

# -- DOC_PARSER_UPLOAD=false(경로 전달) 이고 전처리기가 다른 컨테이너일 때만: 공유 볼륨 --
# 원본을 복사해 둘 공유 디렉터리. 비면 원본 경로를 그대로 넘긴다(같은 호스트일 때)
DOC_PARSER_SHARED_DIR=
# 호스트/컨테이너 마운트 경로가 다를 때만. 비우면 둘 다 DOC_PARSER_SHARED_DIR 값을 쓴다
DOC_PARSER_SHARED_HOST_DIR=
DOC_PARSER_SHARED_CONTAINER_DIR=


# ══════════════════════════════════════════════════════════════════════
# [package 소비] `index-changeset` 가 수집기 JSONL package 를 먹을 때만 의미 있음
#   무슨 record 가 오느냐는 생산자(temporal_law)가 정하고, 소비자는 다 처리한다.
#   여기서 켜고 끄는 축은 아래 넷이다.
# ══════════════════════════════════════════════════════════════════════

# -- 1) 원본 파일 수령 · 수집기 PACKAGE_ATTACHMENT_MODE=file_transfer 일 때만 --
#   base64 모드는 파일이 JSONL 안에 들어 있어 이 폴더가 필요 없다.
# 수집기 PACKAGE_FILE_STAGE_DIR 과 같은 폴더를 가리킬 것
PACKAGE_FILE_INBOX_DIR=
PACKAGE_DELETE_CONSUMED_FILES=false      # 전처리까지 성공한 inbox 파일을 지울지(실패분은 재시도 위해 남긴다)
# 전처리 여부 자체는 DOC_PARSER_BASE_URL 유무로 자동 결정된다. 강제로 뒤집을 때만 아래를 쓴다.
# PACKAGE_PREPROCESS_FILES=true          # file 레코드를 전처리할지 override(하위호환 키)

# -- 2) 데이터 레포 미러 · 내부망에 레포 레이아웃을 유지할 때만 --
#   document 는 git_path 위치의 .json 으로, 원본 파일은 문서 밑 알맞은 서브폴더로 갱신한다.
PACKAGE_MIRROR_REPO=false                # 증분마다 LAW_REPO_PATH 등 레포 파일을 최신화할지
PACKAGE_MIRROR_PUSH=false                # 미러 후 내부 git 서버로 commit+push 할지(origin 을 내부 서버로 지정해 둘 것)

# -- 3) 원문 별도 보관 · 레포 미러 대신 평면 구조로 쌓을 때만 --
PACKAGE_STORE_ORIGINAL=false             # document/원본 파일을 별도 저장소에 보관할지
# 그 저장 루트({이 경로}/{source}/{law_id}/... 평면 구조)
PACKAGE_ORIGINAL_DIR=

# -- 4) package 청소 --
PACKAGE_DELETE_CONSUMED_PACKAGE=false    # 무오류로 소비한 JSONL 을 지울지(오류가 있으면 재시도 위해 남긴다)

# -- 5) 격리 시 되돌림(nack) --
#   package 소비에 최종 실패해 failed/ 로 격리할 때, 그 안의 law_id 목록을 여기에 남긴다.
#   생산자(temporal_law)는 emit 직전에 이 폴더를 읽어 그 문서들을 재발송(일시장애 소진) 또는
#   재수집(파싱·계약 위반 같은 결정적 오류)으로 되돌린다.
#   ⚠ 이게 없으면 격리된 문서는 생산자 기준 '발송 완료' 라 **다음 개정까지 색인되지 않는다**
#     (조용한 유실). 수집기의 PACKAGE_NACK_DIR 과 **같은 경로**여야 한다.
#   비우면 소비 폴더 밑 nack/ — folder sink 구성에서는 생산자 기본값과 자동으로 일치한다.
PACKAGE_NACK_DIR=


# ──────────────────────────────────────────────────────────────────────
# [Temporal · 선택] 색인 워커(`law_indexer.worker`)를 띄울 때만 필요
#   CLI(`index`/`search`)만 쓰면 이 블록은 없어도 된다.
# ──────────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233          # 단일망이면 수집기와 같은 클러스터, 분리망이면 내부망 것
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS=false                       # true 면 TLS 로 접속
INDEX_TASK_QUEUE=law-embedding           # 이 워커가 폴링할 큐. 수집기 INDEX_TASK_QUEUE 와 같아야 자동 트리거가 이어진다
INDEX_ACTIVITY_WORKERS=2                 # 동기 activity(임베딩·Weaviate)를 돌릴 스레드 수
INDEX_HEARTBEAT_TIMEOUT_MIN=5            # 활동 생존신호(30초 주기) 허용 시간(분). 0=끔(오발동 시 스위치)
