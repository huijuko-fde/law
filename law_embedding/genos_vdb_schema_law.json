{
  "class": "LegalProvisionIndex",
  "description": "법령(법률·시행령·시행규칙 = LAW 레포) 조문/부칙/별표/개정문/파일 청크. self-provided vector(외부 임베딩 주입, vectorizer none) · HNSW cosine · BM25(b=0.75, k1=1.2)는 search_text 단일 속성(kagome_kr 한국어 형태소 — Weaviate 에 ENABLE_TOKENIZER_KAGOME_KR 모듈 필요) · 필터(indexFilterable) 18 · 키워드검색 1 · 표시 16 · 총 35 속성. 세 컬렉션(법령/행정규칙/학칙공단)이 같은 속성을 공유하고 클래스 이름만 다르다(데이터 레포당 컬렉션 하나).",
  "vectorizer": "none",
  "vectorIndexType": "hnsw",
  "vectorIndexConfig": {
    "distanceMetric": "cosine",
    "efConstruction": 128,
    "maxConnections": 32,
    "filterStrategy": "acorn",
    "cleanupIntervalSeconds": 300,
    "dynamicEfMin": 100,
    "dynamicEfMax": 500,
    "dynamicEfFactor": 8,
    "ef": -1,
    "flatSearchCutoff": 40000,
    "skip": false,
    "vectorCacheMaxObjects": 1000000000000
  },
  "invertedIndexConfig": {
    "bm25": {
      "b": 0.75,
      "k1": 1.2
    },
    "cleanupIntervalSeconds": 60,
    "indexNullState": false,
    "indexPropertyLength": false,
    "indexTimestamps": false,
    "stopwords": {
      "preset": "en"
    }
  },
  "replicationConfig": {
    "factor": 3,
    "asyncEnabled": true,
    "deletionStrategy": "TimeBasedResolution"
  },
  "shardingConfig": {
    "desiredCount": 3,
    "virtualPerPhysical": 128
  },
  "multiTenancyConfig": {
    "enabled": false,
    "autoTenantCreation": false,
    "autoTenantActivation": false
  },
